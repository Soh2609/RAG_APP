# Gemini API Credentials (Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Vector Database
Qdrant_Cluster_Endpoint=https://your-cluster-url.qdrant.io
Qdrant_Api_Key=your_qdrant_api_key_here
QDRANT_COLLECTION=enterprise_rag

# Groq LLM API
groq_api_key=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Safety & Resilience Controls (set to false in production to fail-fast)
ALLOW_EMBEDDING_FALLBACK=true
QDRANT_ALLOW_LOCAL_FALLBACK=true

# Resource Limits
MAX_FILE_SIZE_BYTES=52428800
MAX_HTTP_BODY_BYTES=10485760
